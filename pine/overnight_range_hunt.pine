//@version=5
// =====================================================================================
//  Overnight Range Hunt
// -------------------------------------------------------------------------------------
//  Idea: the RTH session tends to go after the overnight (Globex) extreme that sits on
//  the same side of the overnight midpoint as the RTH open.
//    - RTH opens in the UPPER half (Mid < Open < High) -> LONG,  target = OVN High
//    - RTH opens in the LOWER half (Low < Open < Mid)  -> SHORT, target = OVN Low
//    - Open exactly at Mid, or outside the overnight range -> no trade
//  Stop = beyond the extreme of the first X minutes of RTH (+ tick buffer).
//  Maximum ONE trade per trading day.
//
//  Built for NQ on a 1-minute chart, but works on any intraday market/timeframe.
//
//  Backtest note: on historical bars Pine fills market orders at the NEXT bar's open,
//  so the backtest entry is the open of the 2nd RTH bar (09:31 on a 1-min chart).
//  In real time, calc_on_every_tick lets the order go out on the first tick of 09:30.
//
//  1-MINUTE PRECISION BACKTEST: a second, independent engine replays every 1-minute
//  bar inside each chart bar (request.security_lower_tf). It enters at the exact 09:30
//  open, builds the stop from 1-minute data and walks the trade minute by minute, so
//  a 5m/15m chart (more history) gives results that follow the 1-minute rules.
//  Its results appear in the dashboard's "1m Precision" column (not the Strategy
//  Tester). TradingView caps lower-timeframe data at roughly 100k bars (~70 sessions
//  of NQ 1-minute data), so a 5m or 15m chart reaches the cap.
//
//  TIMEFRAME CHECK: if no chart bar starts exactly at the RTH open (e.g. 4m charts,
//  because 18:00 -> 09:30 is 930 minutes), chart-timeframe trades are disabled and a
//  warning is shown. The 1m Precision engine is unaffected.
// =====================================================================================
strategy("Overnight Range Hunt", overlay=true, calc_on_every_tick=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=2.0,
     slippage=1, max_labels_count=500, max_lines_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
grpS = "Sessions"
ovnSessIn = input.session("1800-0930", "Overnight (Globex) Session", group=grpS,
     tooltip="End time is exclusive: 1800-0930 includes bars from 18:00 through the 09:29 bar.")
rthSessIn = input.session("0930-1600", "RTH Session", group=grpS)
tz        = input.string("America/New_York", "Session Time Zone", group=grpS)

grpR = "Risk / Trade"
stopWinIn   = input.string("1", "Stop Loss Candle Length (minutes)", options=["1", "5", "15"], group=grpR,
     tooltip="Stop goes beyond the high (short) / low (long) of the first X minutes of RTH. If the chart timeframe is larger than this, the first RTH bar is used.")
bufTicks    = input.int(4, "Stop Loss Buffer (ticks)", minval=0, group=grpR)
safetyPts   = input.float(0.0, "Safety Stop While Opening Window Forms (points, 0 = off)", minval=0, group=grpR,
     tooltip="The real stop is only known once the opening window closes. With a 5/15-min window you may want a hard stop (distance from RTH open) until then.")
flatAtClose = input.bool(true, "Flatten Position at RTH Close", group=grpR)

grpP = "1-Minute Precision Backtest"
usePrecise  = input.bool(true, "Enable 1m Precision Engine", group=grpP,
     tooltip="Replays 1-minute bars to simulate exact 09:30 entries and minute-by-minute exits on any chart timeframe. Results show in the dashboard. It always exits at the RTH close.")
pQty        = input.int(1, "Contracts", minval=1, group=grpP)
pCommSide   = input.float(2.0, "Commission per Contract per Side ($)", minval=0, group=grpP)
pSlipTicks  = input.int(1, "Slippage per Market/Stop Fill (ticks)", minval=0, group=grpP)
showPLines  = input.bool(true, "Draw Precision Trades (entry -> exit lines)", group=grpP)

grpV = "Visuals"
showBg    = input.bool(true, "Shade Upper (green) / Lower (red) Half", group=grpV)
showLbl   = input.bool(true, "Show Daily Bias Label", group=grpV)
showTable = input.bool(true, "Show Stats Dashboard", group=grpV)

// ─────────────────────────────────────────────────────────────────────────────
// SESSION HELPERS
// ─────────────────────────────────────────────────────────────────────────────
if timeframe.isdwm
    runtime.error("Overnight Range Hunt needs an intraday chart (1-minute recommended).")

// Force all 7 days so the Sunday-evening Globex open is included.
withDays(s) => str.contains(s, ":") ? s : s + ":1234567"
ovnSess = withDays(ovnSessIn)
rthSess = withDays(rthSessIn)

inOvn = not na(time(timeframe.period, ovnSess, tz))
inRth = not na(time(timeframe.period, rthSess, tz))

newOvn      = inOvn and not inOvn[1]   // first bar of a new overnight session -> new trading day
rthStartBar = inRth and not inRth[1]   // first bar of RTH

// RTH end hour/minute parsed from "HHMM-HHMM"
rthEndH = int(str.tonumber(str.substring(rthSessIn, 5, 7)))
rthEndM = int(str.tonumber(str.substring(rthSessIn, 7, 9)))

stopWinMin = int(str.tonumber(stopWinIn))

// Session boundaries as minutes-of-day (used by the alignment check and 1m engine)
hhmm(s, i) => int(str.tonumber(str.substring(s, i, i + 2))) * 60 + int(str.tonumber(str.substring(s, i + 2, i + 4)))
inWin(m, a, b) => a < b ? (m >= a and m < b) : (m >= a or m < b)
ovnStartMin = hhmm(ovnSessIn, 0)
ovnEndMin   = hhmm(ovnSessIn, 5)
rthStartMin = hhmm(rthSessIn, 0)
rthEndMin   = hhmm(rthSessIn, 5)

// ─────────────────────────────────────────────────────────────────────────────
// TIMEFRAME ALIGNMENT CHECK
// The first RTH chart bar must open exactly at the RTH start. Otherwise the
// overnight range swallows part of RTH and the "RTH open" is the wrong price.
// ─────────────────────────────────────────────────────────────────────────────
var bool tfAligned = true
var int  cDays     = 0
var int  cFirstT   = na
if rthStartBar
    tfAligned := hour(time, tz) * 60 + minute(time, tz) == rthStartMin
    cDays     += 1
    cFirstT   := na(cFirstT) ? time : cFirstT
buf        = bufTicks * syminfo.mintick

// ─────────────────────────────────────────────────────────────────────────────
// STATE (reset once per trading day)
// ─────────────────────────────────────────────────────────────────────────────
var bool  sawOvnStart = false   // ignore the partial first day on the chart
var float ovnH        = na
var float ovnL        = na
var float ovnMid      = na
var float rthOpen     = na
var bool  levelsReady = false   // true from RTH open until next overnight start
var int   rthStartTs  = na
var int   rthEndTs    = na
var int   windowEnd   = na
var float winH        = na
var float winL        = na
var bool  windowDone  = false
var int   dayDir      = 0       // 1 = long, -1 = short, 0 = no trade
var bool  tradeTaken  = false
var bool  tappedH     = false
var bool  tappedL     = false
var float stopLvl     = na
var float tgtLvl      = na

// ─────────────────────────────────────────────────────────────────────────────
// 1) OVERNIGHT CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
if newOvn
    // New trading day: reset everything
    sawOvnStart := true
    ovnH        := high
    ovnL        := low
    ovnMid      := na
    rthOpen     := na
    levelsReady := false
    windowEnd   := na
    winH        := na
    winL        := na
    windowDone  := false
    dayDir      := 0
    tradeTaken  := false
    tappedH     := false
    tappedL     := false
    stopLvl     := na
    tgtLvl      := na
else if inOvn and sawOvnStart and not levelsReady
    ovnH := na(ovnH) ? high : math.max(ovnH, high)
    ovnL := na(ovnL) ? low  : math.min(ovnL, low)

// ─────────────────────────────────────────────────────────────────────────────
// 2) RTH OPEN LOGIC (evaluated once per day on the first RTH bar)
// ─────────────────────────────────────────────────────────────────────────────
if rthStartBar and sawOvnStart and not na(ovnH) and not na(ovnL)
    ovnMid      := (ovnH + ovnL) / 2
    rthOpen     := open
    levelsReady := true
    rthStartTs  := time
    rthEndTs    := timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), rthEndH, rthEndM)
    windowEnd   := time + stopWinMin * 60 * 1000
    winH        := high
    winL        := low
    // Strict comparisons: open exactly at Mid or outside/at the range edges = no trade
    dayDir := rthOpen > ovnMid and rthOpen < ovnH ? 1 : rthOpen < ovnMid and rthOpen > ovnL ? -1 : 0
    tgtLvl := dayDir == 1 ? ovnH : dayDir == -1 ? ovnL : na
else if levelsReady and inRth and not windowDone and time < windowEnd
    // Still inside the opening window: extend its high/low
    winH := math.max(winH, high)
    winL := math.min(winL, low)

// Opening window is complete once a CONFIRMED bar closes at/after windowEnd
if levelsReady and not windowDone and not na(windowEnd) and time_close >= windowEnd and barstate.isconfirmed
    windowDone := true

// ─────────────────────────────────────────────────────────────────────────────
// 3) ENTRY (only on the first RTH bar, max one trade per day)
// ─────────────────────────────────────────────────────────────────────────────
// Extra guard against re-entry in real time (var values roll back intrabar)
noTradeYetToday = strategy.closedtrades == 0 ? true : strategy.closedtrades.entry_time(math.max(strategy.closedtrades - 1, 0)) < nz(rthStartTs)

// Skip the day if price already reached the target on the signal bar. Otherwise the
// entry fills (next bar open) beyond the target and the take-profit closes it at once
// for a commission/slippage loss. This happens mostly on 5m+ charts.
targetUntouched = dayDir == 1 ? high < ovnH : dayDir == -1 ? low > ovnL : false

canEnter = tfAligned and rthStartBar and levelsReady and dayDir != 0 and not tradeTaken and strategy.position_size == 0 and noTradeYetToday and targetUntouched

if canEnter
    if dayDir == 1
        strategy.entry("ORH Long", strategy.long, comment="Long -> OVN H")
        alert("Overnight Range Hunt: LONG " + syminfo.ticker + " @ " + str.tostring(rthOpen, format.mintick) +
             " | Target OVN H " + str.tostring(ovnH, format.mintick), alert.freq_once_per_bar)
    else
        strategy.entry("ORH Short", strategy.short, comment="Short -> OVN L")
        alert("Overnight Range Hunt: SHORT " + syminfo.ticker + " @ " + str.tostring(rthOpen, format.mintick) +
             " | Target OVN L " + str.tostring(ovnL, format.mintick), alert.freq_once_per_bar)
    tradeTaken := true

// ─────────────────────────────────────────────────────────────────────────────
// 4) EXIT (target = OVN extreme, stop = opening-window extreme +/- buffer)
// ─────────────────────────────────────────────────────────────────────────────
if tradeTaken and dayDir != 0
    if windowDone
        stopLvl := dayDir == 1 ? winL - buf : winH + buf
    else
        // Window not finished yet: optional hard safety stop, otherwise target only
        stopLvl := safetyPts > 0 ? (dayDir == 1 ? rthOpen - safetyPts : rthOpen + safetyPts) : na

    if dayDir == 1
        strategy.exit("ORH Long Exit", from_entry="ORH Long", stop=stopLvl, limit=tgtLvl,
             comment_profit="TP OVN H", comment_loss="SL")
    else
        strategy.exit("ORH Short Exit", from_entry="ORH Short", stop=stopLvl, limit=tgtLvl,
             comment_profit="TP OVN L", comment_loss="SL")

// Time exit: flatten on the last RTH bar
if flatAtClose and strategy.position_size != 0 and inRth and not na(rthEndTs) and time_close >= rthEndTs
    strategy.close_all(comment="RTH Close", immediately=true)

// ─────────────────────────────────────────────────────────────────────────────
// 5) TAP ALERTS (first touch of OVN High / OVN Low during RTH)
// ─────────────────────────────────────────────────────────────────────────────
tapH = levelsReady and inRth and not tappedH and high >= ovnH
tapL = levelsReady and inRth and not tappedL and low  <= ovnL
if tapH
    tappedH := true
    alert("Overnight Range Hunt: OVN HIGH tapped (" + str.tostring(ovnH, format.mintick) + ") on " + syminfo.ticker, alert.freq_once_per_bar)
if tapL
    tappedL := true
    alert("Overnight Range Hunt: OVN LOW tapped (" + str.tostring(ovnL, format.mintick) + ") on " + syminfo.ticker, alert.freq_once_per_bar)

// ─────────────────────────────────────────────────────────────────────────────
// 6) 1-MINUTE PRECISION ENGINE
// Replays each 1-minute bar inside the current chart bar, in order. Independent of
// the chart timeframe and of the Strategy Tester. Conservative assumptions:
//   - entry at the exact 09:30 1m open + slippage
//   - if stop and target are both inside the same 1-minute bar, the STOP is assumed
//   - stops fill at the stop (or the 1m open if it gapped through) + slippage
//   - target fills at the target (limit order, no slippage)
// ─────────────────────────────────────────────────────────────────────────────
ltfStr = timeframe.in_seconds() >= 60 ? "1" : timeframe.period
[aT, aO, aH, aL, aC] = request.security_lower_tf(syminfo.tickerid, ltfStr, [time, open, high, low, close], ignore_invalid_timeframe=true)

slipPx = pSlipTicks * syminfo.mintick

var bool  xInit    = false   // first 1m bar seen (avoid treating a mid-session start as a new day)
var bool  xPrevOvn = false
var bool  xPrevRth = false
var float xPrevC   = na
var int   xPrevT   = na
var bool  xSaw     = false
var float xH       = na
var float xL       = na
var float xMid     = na
var float xOpen    = na
var bool  xReady   = false
var int   xDir     = 0
var bool  xInTrade = false
var float xEntry   = na
var int   xEntryT  = na
var float xTgt     = na
var float xStop    = na
var float xWinH    = na
var float xWinL    = na
var int   xWinEnd  = na
var bool  xWinDone = false
// stats
var int   xTrades  = 0
var int   xWins    = 0
var int   xLosses  = 0
var int   xTP      = 0
var int   xSL      = 0
var int   xTime    = 0
var int   xAmb     = 0
var float xGrossW  = 0.0
var float xGrossL  = 0.0
var int   xDays    = 0
var int   xFirstT  = na

// Book a finished precision trade
f_book(exitPx, exitT, reason) =>
    pnl = (exitPx - xEntry) * xDir * syminfo.pointvalue * pQty - 2 * pCommSide * pQty
    if showPLines
        line.new(xEntryT, xEntry, exitT, exitPx, xloc=xloc.bar_time,
             color=pnl > 0 ? color.new(color.lime, 0) : color.new(color.orange, 0), width=2, style=line.style_arrow_right)
    pnl

if usePrecise and array.size(aT) > 0
    for i = 0 to array.size(aT) - 1
        t = array.get(aT, i)
        o = array.get(aO, i)
        h = array.get(aH, i)
        l = array.get(aL, i)
        c = array.get(aC, i)
        m = hour(t, tz) * 60 + minute(t, tz)
        isOvn = inWin(m, ovnStartMin, ovnEndMin)
        isRth = inWin(m, rthStartMin, rthEndMin)
        if not xInit
            xInit    := true
            xPrevOvn := isOvn
            xPrevRth := isRth
            xPrevC   := c
            xPrevT   := t
            continue

        // Safety: left RTH while still in a trade (e.g. missing last minute) -> time exit
        if xInTrade and xPrevRth and not isRth
            pnl = f_book(xPrevC - xDir * slipPx, xPrevT, 3)
            xTrades += 1
            xTime   += 1
            if pnl > 0
                xWins   += 1
                xGrossW += pnl
            else
                xLosses += 1
                xGrossL -= pnl
            xInTrade := false

        // New overnight session -> new trading day
        if isOvn and not xPrevOvn
            xSaw     := true
            xH       := h
            xL       := l
            xMid     := na
            xOpen    := na
            xReady   := false
            xDir     := 0
            xInTrade := false
            xStop    := na
            xTgt     := na
            xWinH    := na
            xWinL    := na
            xWinDone := false
        else if isOvn and xSaw and not xReady
            xH := math.max(xH, h)
            xL := math.min(xL, l)

        // RTH open: decide direction and enter at the exact 1m open
        if isRth and not xPrevRth and xSaw and not na(xH) and not xReady
            xReady  := true
            xMid    := (xH + xL) / 2
            xOpen   := o
            xDays   += 1
            xFirstT := na(xFirstT) ? t : xFirstT
            xDir    := xOpen > xMid and xOpen < xH ? 1 : xOpen < xMid and xOpen > xL ? -1 : 0
            xWinEnd := t + stopWinMin * 60000
            if xDir != 0
                xInTrade := true
                xEntry   := o + xDir * slipPx
                xEntryT  := t
                xTgt     := xDir == 1 ? xH : xL

        // Manage the open trade on this 1-minute bar
        if xInTrade
            if not xWinDone and t < xWinEnd
                xWinH := na(xWinH) ? h : math.max(xWinH, h)
                xWinL := na(xWinL) ? l : math.min(xWinL, l)
            stopNow = xWinDone ? xStop : safetyPts > 0 ? xOpen - xDir * safetyPts : na
            hitTgt  = xDir == 1 ? h >= xTgt : l <= xTgt
            hitStop = not na(stopNow) and (xDir == 1 ? l <= stopNow : h >= stopNow)
            exitPx  = float(na)
            reason  = 0
            if hitStop
                exitPx := (xDir == 1 ? math.min(o, stopNow) : math.max(o, stopNow)) - xDir * slipPx
                reason := 2
                if hitTgt
                    xAmb += 1
            else if hitTgt
                exitPx := xDir == 1 ? math.max(o, xTgt) : math.min(o, xTgt)
                reason := 1
            else if (m + 1) % 1440 == rthEndMin   // last RTH minute: precision engine always flattens
                exitPx := c - xDir * slipPx
                reason := 3
            if reason != 0
                pnl = f_book(exitPx, t, reason)
                xTrades += 1
                if reason == 1
                    xTP += 1
                else if reason == 2
                    xSL += 1
                else
                    xTime += 1
                if pnl > 0
                    xWins   += 1
                    xGrossW += pnl
                else
                    xLosses += 1
                    xGrossL -= pnl
                xInTrade := false
            else if not xWinDone and t + 60000 >= xWinEnd
                // Opening window closed with this bar: the real stop is now known
                xWinDone := true
                xStop    := xDir == 1 ? xWinL - buf : xWinH + buf

        xPrevOvn := isOvn
        xPrevRth := isRth
        xPrevC   := c
        xPrevT   := t

// ─────────────────────────────────────────────────────────────────────────────
// 7) PLOTS (1m-precise levels when available, otherwise chart-timeframe levels)
// ─────────────────────────────────────────────────────────────────────────────
usePLv  = usePrecise and xReady
lvH     = usePLv ? xH    : levelsReady ? ovnH    : na
lvL     = usePLv ? xL    : levelsReady ? ovnL    : na
lvMid   = usePLv ? xMid  : levelsReady ? ovnMid  : na
lvOpen  = usePLv ? xOpen : levelsReady ? rthOpen : na

// ─────────────────────────────────────────────────────────────────────────────
// 7b) CHART PLOTS
// ─────────────────────────────────────────────────────────────────────────────
pH = plot(lvH,    "OVN High", color.green, 2, plot.style_linebr)
pL = plot(lvL,    "OVN Low",  color.red,   2, plot.style_linebr)
pM = plot(lvMid,  "OVN Mid",  color.gray,  1, plot.style_circles)   // dotted look
plot(lvOpen, "RTH Open", color.blue, 2, plot.style_linebr)

fill(pM, pH, showBg ? color.new(color.green, 90) : na, "Upper Half")
fill(pM, pL, showBg ? color.new(color.red,   90) : na, "Lower Half")

inPos = strategy.position_size != 0
plot(inPos ? stopLvl : na, "Active Stop",   color.orange, 1, plot.style_linebr)
plot(inPos ? tgtLvl  : na, "Active Target", color.lime,   1, plot.style_linebr)

plotshape(tapH, "OVN High Tap", shape.triangledown, location.abovebar, color.green, size=size.tiny)
plotshape(tapL, "OVN Low Tap",  shape.triangleup,   location.belowbar, color.red,   size=size.tiny)

if showLbl and rthStartBar and levelsReady and barstate.isconfirmed
    skipped = dayDir != 0 and (not targetUntouched or not tfAligned)
    why = not tfAligned ? "(timeframe not aligned to RTH open)" : dayDir == 1 ? "(OVN H hit on open bar)" : "(OVN L hit on open bar)"
    txt = skipped ? (dayDir == 1 ? "LONG bias - SKIP\n" : "SHORT bias - SKIP\n") + why :
         dayDir == 1 ? "LONG → OVN H" : dayDir == -1 ? "SHORT → OVN L" : "NO TRADE"
    col = skipped ? color.gray : dayDir == 1 ? color.green : dayDir == -1 ? color.red : color.gray
    label.new(bar_index, dayDir == -1 ? high : low, txt, color=col, textcolor=color.white,
         style=dayDir == -1 ? label.style_label_down : label.style_label_up, size=size.small)


// ─────────────────────────────────────────────────────────────────────────────
// 8) STATS DASHBOARD
//    Column 1 = chart-timeframe trades (what the Strategy Tester shows)
//    Column 2 = 1-minute precision engine
// ─────────────────────────────────────────────────────────────────────────────
var int tpCount   = 0
var int slCount   = 0
var int timeCount = 0
if ta.change(strategy.closedtrades) > 0
    idx = strategy.closedtrades - 1
    px  = strategy.closedtrades.exit_price(idx)
    sz  = strategy.closedtrades.size(idx)          // + long, - short
    tol = syminfo.mintick * 2
    if not na(tgtLvl) and ((sz > 0 and px >= tgtLvl - tol) or (sz < 0 and px <= tgtLvl + tol))
        tpCount += 1
    else if not na(stopLvl) and ((sz > 0 and px <= stopLvl + tol) or (sz < 0 and px >= stopLvl - tol))
        slCount += 1
    else
        timeCount += 1

f_pct(w, n) => n > 0 ? str.tostring(w * 100.0 / n, "#.0") + "%" : "-"
f_pf(gw, gl) => gl > 0 ? str.tostring(gw / gl, "#.00") : gw > 0 ? "∞" : "-"
f_rr(gw, w, gl, l) => w > 0 and l > 0 and gl > 0 ? str.tostring((gw / w) / (gl / l), "#.0") + "x" : "-"
f_date(t) => na(t) ? "-" : str.format("{0,date,yyyy-MM-dd}", t)

var table dash = table.new(position.top_right, 3, 11, bgcolor=color.new(color.black, 15),
     border_color=color.new(color.gray, 60), border_width=1)

if showTable and barstate.islast
    tc  = color.white
    ts  = size.small
    up  = color.lime
    dn  = color.red
    // chart-TF figures
    cN  = strategy.closedtrades
    cW  = strategy.wintrades
    cL  = strategy.losstrades
    cGW = strategy.grossprofit
    cGL = strategy.grossloss
    cNP = strategy.netprofit
    // precision figures
    xNP = xGrossW - xGrossL

    table.cell(dash, 0, 0, "Overnight Range Hunt", text_color=tc, text_size=ts)
    table.cell(dash, 1, 0, "Chart " + timeframe.period + (timeframe.isminutes ? "m" : ""), text_color=tc, text_size=ts)
    table.cell(dash, 2, 0, usePrecise ? "1m Precision" : "1m Precision (off)", text_color=color.aqua, text_size=ts)

    table.cell(dash, 0, 1, "Trades",        text_color=tc, text_size=ts)
    table.cell(dash, 1, 1, str.tostring(cN), text_color=tc, text_size=ts)
    table.cell(dash, 2, 1, str.tostring(xTrades), text_color=tc, text_size=ts)

    table.cell(dash, 0, 2, "Wins / Losses", text_color=tc, text_size=ts)
    table.cell(dash, 1, 2, str.tostring(cW) + " / " + str.tostring(cL), text_color=tc, text_size=ts)
    table.cell(dash, 2, 2, str.tostring(xWins) + " / " + str.tostring(xLosses), text_color=tc, text_size=ts)

    table.cell(dash, 0, 3, "Win Rate",      text_color=tc, text_size=ts)
    table.cell(dash, 1, 3, f_pct(cW, cN),   text_color=tc, text_size=ts)
    table.cell(dash, 2, 3, f_pct(xWins, xTrades), text_color=tc, text_size=ts)

    table.cell(dash, 0, 4, "Target / Stop / Time", text_color=tc, text_size=ts)
    table.cell(dash, 1, 4, str.tostring(tpCount) + " / " + str.tostring(slCount) + " / " + str.tostring(timeCount), text_color=tc, text_size=ts)
    table.cell(dash, 2, 4, str.tostring(xTP) + " / " + str.tostring(xSL) + " / " + str.tostring(xTime), text_color=tc, text_size=ts)

    table.cell(dash, 0, 5, "Net P/L ($)",   text_color=tc, text_size=ts)
    table.cell(dash, 1, 5, str.tostring(cNP, "#,##0"), text_color=cNP >= 0 ? up : dn, text_size=ts)
    table.cell(dash, 2, 5, str.tostring(xNP, "#,##0"), text_color=xNP >= 0 ? up : dn, text_size=ts)

    table.cell(dash, 0, 6, "Profit Factor", text_color=tc, text_size=ts)
    table.cell(dash, 1, 6, f_pf(cGW, cGL),  text_color=tc, text_size=ts)
    table.cell(dash, 2, 6, f_pf(xGrossW, xGrossL), text_color=tc, text_size=ts)

    table.cell(dash, 0, 7, "Avg Win ÷ Avg Loss", text_color=tc, text_size=ts)
    table.cell(dash, 1, 7, f_rr(cGW, cW, cGL, cL), text_color=tc, text_size=ts)
    table.cell(dash, 2, 7, f_rr(xGrossW, xWins, xGrossL, xLosses), text_color=tc, text_size=ts)

    table.cell(dash, 0, 8, "Sessions / From", text_color=tc, text_size=ts)
    table.cell(dash, 1, 8, str.tostring(cDays) + " / " + f_date(cFirstT), text_color=tc, text_size=ts)
    table.cell(dash, 2, 8, str.tostring(xDays) + " / " + f_date(xFirstT), text_color=tc, text_size=ts)

    table.cell(dash, 0, 9, "Same-minute TP+SL (as SL)", text_color=tc, text_size=ts)
    table.cell(dash, 1, 9, "-", text_color=tc, text_size=ts)
    table.cell(dash, 2, 9, str.tostring(xAmb), text_color=tc, text_size=ts)

    warn = not tfAligned ? "⚠ No chart bar opens at RTH start on this timeframe - chart trades disabled. Use 1/2/3/5/10/15m or rely on 1m Precision." : ""
    table.cell(dash, 0, 10, warn, text_color=color.yellow, text_size=ts, bgcolor=not tfAligned ? color.new(color.red, 40) : na)
    table.cell(dash, 1, 10, "", text_size=ts)
    table.cell(dash, 2, 10, "", text_size=ts)
    table.merge_cells(dash, 0, 10, 2, 10)

//@version=5
// =============================================================================
//  ACE Model - Strategy
//  Backtestable version of the ACE Model indicator. Same swing detection and
//  setup rules; trades are placed with strategy.entry / strategy.exit so the
//  Strategy Tester reports net profit, win rate, profit factor and drawdown.
//
//  Fill model: process_orders_on_close = true, so the entry fills at the close
//  of the confirmation (engulfing) candle - the same price the trade plan
//  shows. TP is a limit order, SL a stop order, both active from the next bar.
//
//  Capital, order size, pyramiding, commission, slippage, margin and bar
//  magnifier are set in the Properties tab (defaults below). Set commission
//  and slippage to realistic values for your broker before judging results.
// =============================================================================
strategy("ACE Model Strategy", overlay = true,
     initial_capital = 1000000, default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 0, process_orders_on_close = true, calc_on_every_tick = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// -----------------------------------------------------------------------------
// GROUP NAMES
// -----------------------------------------------------------------------------
string G_DETECT = "1. SWING DETECTION"
string G_SWING  = "SETUP 2 SWING"
string G_TRADE  = "TRADE VISUALS"
string G_RULES  = "7. TRADING RULES"
string G_ALERTS = "8. ALERTS"
string G_STRAT  = "9. STRATEGY"

// -----------------------------------------------------------------------------
// 1. SWING DETECTION
// -----------------------------------------------------------------------------
i_pivotLeft  = input.int(5, "Pivot left bars",  minval = 1, group = G_DETECT)
i_pivotRight = input.int(5, "Pivot right bars", minval = 1, group = G_DETECT)

// -----------------------------------------------------------------------------
// SETUP 2 SWING (visuals)
// -----------------------------------------------------------------------------
i_swingLineColor = input.color(color.orange, "Swing line color", group = G_SWING)
i_swingTextColor = input.color(color.orange, "Swing label text color", group = G_SWING)
i_swingLabelBg   = input.color(color.new(color.white, 100), "Swing label background", group = G_SWING)
i_swingLineWidth = input.int(2, "Swing line width", minval = 1, maxval = 10, group = G_SWING)
i_swingLineStyle = input.string("Dashed", "Swing line style", options = ["Solid", "Dashed", "Dotted"], group = G_SWING)
i_swingLabelSize = input.string("Small", "Swing label size", options = ["Tiny", "Small", "Normal", "Large"], group = G_SWING)
i_swingLblOffset = input.int(12, "Swing label offset (ticks)", minval = 0, group = G_SWING)
i_showSwingLbl   = input.bool(true, "Show swing labels", group = G_SWING)
i_showSwingPrice = input.bool(false, "Show price in swing labels", group = G_SWING)
i_maxSwings      = input.int(6, "Swings kept on chart (each side)", minval = 1, maxval = 200, group = G_SWING,
     tooltip = "Older swing lines/labels are deleted to keep the chart readable. Increase to see more history.")

// -----------------------------------------------------------------------------
// TRADE VISUALS
// -----------------------------------------------------------------------------
i_tpColor     = input.color(color.new(color.green, 80), "TP box color", group = G_TRADE)
i_slColor     = input.color(color.new(color.red, 80), "SL box color", group = G_TRADE)
i_entryColor  = input.color(color.blue, "Entry line color", group = G_TRADE)
i_boxTextCol  = input.color(color.white, "Box text color", group = G_TRADE)
i_projBars    = input.int(20, "Minimum box length (bars)", minval = 1, maxval = 400, group = G_TRADE)
i_maxPlans    = input.int(5, "Trade plans kept on chart", minval = 1, maxval = 100, group = G_TRADE)

// -----------------------------------------------------------------------------
// 7. TRADING RULES
// -----------------------------------------------------------------------------
i_s2Neutral   = input.bool(false, "S2 origin includes neutral candlesticks", group = G_RULES,
     tooltip = "When enabled, a neutral (doji) candle may act as the opposite-colour candle that the engulfing candle swallows.")
i_vaCheck     = input.bool(true, "VA boundary must remain inside 0.588-0.360", group = G_RULES,
     tooltip = "Entry must sit between the 0.360 and 0.588 retracement of the last impulse leg (0 = leg end, 1 = leg origin).")
i_targetMode  = input.string("Fib 0", "All setups target mode", options = ["Fib 0", "Fib -0.27", "Fib -0.5", "Fib -1", "Fib -1.618"], group = G_RULES)
i_maxInvalid  = input.int(2, "Max invalidated S2 attempts per day", minval = 0, group = G_RULES)

// -----------------------------------------------------------------------------
// 8. ALERTS  (use "alert() function calls only" or "Order fills" when creating the alert)
// -----------------------------------------------------------------------------
i_alertSwing = input.bool(true, "Setup and swing events", group = G_ALERTS)
i_alertPlan  = input.bool(true, "New valid trade plan", group = G_ALERTS)

// -----------------------------------------------------------------------------
// 9. STRATEGY
// -----------------------------------------------------------------------------
i_direction  = input.string("Long and short", "Trade direction", options = ["Long and short", "Long only", "Short only"], group = G_STRAT)
i_useDates   = input.bool(false, "Limit backtest to date range", group = G_STRAT)
i_startDate  = input.time(timestamp("2026-01-01T00:00:00"), "Start", group = G_STRAT)
i_endDate    = input.time(timestamp("2099-12-31T00:00:00"), "End", group = G_STRAT)
i_showStats  = input.bool(true, "Show stats table", group = G_STRAT)
i_statsPos   = input.string("Top right", "Stats table position", options = ["Top right", "Bottom right", "Top left", "Bottom left", "Middle right", "Bottom center"], group = G_STRAT)
i_statsSize  = input.string("Tiny", "Stats table text size", options = ["Tiny", "Small", "Normal", "Large"], group = G_STRAT)
i_recentN    = input.int(5, "Recent trades shown in table", minval = 0, maxval = 20, group = G_STRAT)

// -----------------------------------------------------------------------------
// HELPERS
// -----------------------------------------------------------------------------
f_lineStyle(string s) =>
    s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed

f_labelSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

f_fmt(float v) =>
    str.tostring(v, format.mintick)

lineStyle  = f_lineStyle(i_swingLineStyle)
labelSize  = f_labelSize(i_swingLabelSize)
lblOffset  = i_swingLblOffset * syminfo.mintick
targetFib  = str.tonumber(str.replace_all(i_targetMode, "Fib ", ""))

// -----------------------------------------------------------------------------
// SWING DETECTION
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, i_pivotLeft, i_pivotRight)
pl = ta.pivotlow(low, i_pivotLeft, i_pivotRight)

newSH = not na(ph)
newSL = not na(pl)

var float lastSH    = na
var int   lastSHbar = na
var float lastSL    = na
var int   lastSLbar = na
var line  shLine    = na
var line  slLine    = na
var shDrawLines  = array.new_line()
var shDrawLabels = array.new_label()
var slDrawLines  = array.new_line()
var slDrawLabels = array.new_label()

// keep only the newest `maxCount` drawings in each array
f_trimLines(line[] arr, int maxCount) =>
    while array.size(arr) > maxCount
        line.delete(array.shift(arr))

f_trimLabels(label[] arr, int maxCount) =>
    while array.size(arr) > maxCount
        label.delete(array.shift(arr))

f_swingText(string tag, float price) =>
    i_showSwingPrice ? tag + " " + f_fmt(price) : tag

if newSH
    pivotBar = bar_index - i_pivotRight
    // terminate the previous swing-high line at the new swing
    if not na(shLine)
        line.set_x2(shLine, pivotBar)
    lastSH    := ph
    lastSHbar := pivotBar
    shLine    := line.new(pivotBar, ph, bar_index, ph, color = i_swingLineColor, width = i_swingLineWidth, style = lineStyle)
    array.push(shDrawLines, shLine)
    f_trimLines(shDrawLines, i_maxSwings)
    if i_showSwingLbl
        array.push(shDrawLabels, label.new(pivotBar, ph + lblOffset, f_swingText("SH", ph), style = label.style_label_down,
             color = i_swingLabelBg, textcolor = i_swingTextColor, size = labelSize))
        f_trimLabels(shDrawLabels, i_maxSwings)

if newSL
    pivotBar = bar_index - i_pivotRight
    if not na(slLine)
        line.set_x2(slLine, pivotBar)
    lastSL    := pl
    lastSLbar := pivotBar
    slLine    := line.new(pivotBar, pl, bar_index, pl, color = i_swingLineColor, width = i_swingLineWidth, style = lineStyle)
    array.push(slDrawLines, slLine)
    f_trimLines(slDrawLines, i_maxSwings)
    if i_showSwingLbl
        array.push(slDrawLabels, label.new(pivotBar, pl - lblOffset, f_swingText("SL", pl), style = label.style_label_up,
             color = i_swingLabelBg, textcolor = i_swingTextColor, size = labelSize))
        f_trimLabels(slDrawLabels, i_maxSwings)

// keep the most recent swing lines extended to the current bar
if not na(shLine) and not newSH
    line.set_x2(shLine, bar_index)
if not na(slLine) and not newSL
    line.set_x2(slLine, bar_index)

// -----------------------------------------------------------------------------
// ASIA SESSION VALUE FILTER (optional, off by default)
//   Builds a volume profile of the Asia session (19:00-03:00 New York time)
//   from the chart's bars and derives the Asia POC / VAH / VAL. Levels are only
//   calculated after the Asia session closes, so they never repaint.
//   Trend setups work best once price has been accepted away from overnight
//   value, so the filter only allows trades in that direction:
//     Acceptance    : longs above the Asia POC, shorts below it
//     Outside value : longs above the Asia VAH, shorts below the Asia VAL
// -----------------------------------------------------------------------------
string G_ASIA = "10. ASIA VALUE FILTER"
i_asiaFilter = input.string("Off", "Asia value filter", options = ["Off", "Acceptance (POC)", "Outside value (VAH / VAL)"], group = G_ASIA,
     tooltip = "Off keeps the original strategy. Acceptance: longs only above the Asia POC, shorts only below it. Outside value: longs only above the Asia VAH, shorts only below the Asia VAL.")
i_asiaSess   = input.session("1900-0300", "Asia session (New York time)", group = G_ASIA)
i_asiaRows   = input.int(50, "Profile rows", minval = 10, maxval = 300, group = G_ASIA)
i_asiaVaPct  = input.float(70, "Value area %", minval = 10, maxval = 100, step = 1, group = G_ASIA)
i_asiaShow   = input.bool(false, "Plot Asia POC / VAH / VAL", group = G_ASIA)

string ASIA_TZ = "America/New_York"

f_asiaProfile(float[] hs, float[] ls, float[] vs, float top, float bot, int rows, float vaPct) =>
    float poc = na
    float vah = na
    float val = na
    int   n   = array.size(hs)
    if n > 0 and top > bot
        float step = (top - bot) / rows
        bins = array.new_float(rows, 0.0)
        for i = 0 to n - 1
            int lo = math.max(0, math.min(rows - 1, math.floor((array.get(ls, i) - bot) / step)))
            int hi = math.max(0, math.min(rows - 1, math.floor((array.get(hs, i) - bot) / step)))
            float per = array.get(vs, i) / (hi - lo + 1)
            for b = lo to hi
                array.set(bins, b, array.get(bins, b) + per)
        float total = array.sum(bins)
        if total <= 0
            poc := (top + bot) / 2
            vah := top
            val := bot
        else
            int pocIdx = array.indexof(bins, array.max(bins))
            float acc = array.get(bins, pocIdx)
            int up = pocIdx
            int dn = pocIdx
            while acc < total * vaPct / 100 and (up < rows - 1 or dn > 0)
                float vUp = up < rows - 1 ? array.get(bins, up + 1) : -1.0
                float vDn = dn > 0 ? array.get(bins, dn - 1) : -1.0
                if vUp >= vDn
                    up += 1
                    acc += vUp
                else
                    dn -= 1
                    acc += vDn
            poc := bot + (pocIdx + 0.5) * step
            vah := bot + (up + 1) * step
            val := bot + dn * step
    [poc, vah, val]

asiaIn    = not na(time(timeframe.period, i_asiaSess, ASIA_TZ))
asiaBegin = asiaIn and not asiaIn[1]
asiaDone  = asiaIn[1] and not asiaIn

var asiaHs = array.new_float()
var asiaLs = array.new_float()
var asiaVs = array.new_float()
var float asiaTop = na
var float asiaBot = na
var float asiaPOC = na
var float asiaVAH = na
var float asiaVAL = na

if asiaBegin
    array.clear(asiaHs)
    array.clear(asiaLs)
    array.clear(asiaVs)
    asiaTop := high
    asiaBot := low

if asiaIn
    array.push(asiaHs, high)
    array.push(asiaLs, low)
    array.push(asiaVs, nz(volume))
    asiaTop := math.max(nz(asiaTop, high), high)
    asiaBot := math.min(nz(asiaBot, low), low)

if asiaDone and array.size(asiaHs) > 0
    [aPoc, aVah, aVal] = f_asiaProfile(asiaHs, asiaLs, asiaVs, asiaTop, asiaBot, i_asiaRows, i_asiaVaPct)
    asiaPOC := aPoc
    asiaVAH := aVah
    asiaVAL := aVal

asiaFilterOn = i_asiaFilter != "Off"
asiaOutside  = i_asiaFilter == "Outside value (VAH / VAL)"
asiaLongOk   = not asiaFilterOn or (not na(asiaPOC) and close > (asiaOutside ? asiaVAH : asiaPOC))
asiaShortOk  = not asiaFilterOn or (not na(asiaPOC) and close < (asiaOutside ? asiaVAL : asiaPOC))

plot(i_asiaShow ? asiaPOC : na, "Asia POC", color.new(color.red, 0), 1, plot.style_linebr)
plot(i_asiaShow ? asiaVAH : na, "Asia VAH", color.new(color.blue, 0), 1, plot.style_linebr)
plot(i_asiaShow ? asiaVAL : na, "Asia VAL", color.new(color.green, 0), 1, plot.style_linebr)

// -----------------------------------------------------------------------------
// DAILY COUNTERS
// -----------------------------------------------------------------------------
newDay = ta.change(time("D")) != 0

var int invalidToday = 0
var int setupsToday  = 0

if newDay
    invalidToday := 0
    setupsToday  := 0

// -----------------------------------------------------------------------------
// CANDLE PATTERNS (S2 origin)
// -----------------------------------------------------------------------------
bodySize    = math.abs(close - open)
isNeutral   = bodySize <= (high - low) * 0.1
prevNeutral = isNeutral[1]
prevBear    = close[1] < open[1] or (i_s2Neutral and prevNeutral)
prevBull    = close[1] > open[1] or (i_s2Neutral and prevNeutral)

bullEngulf = close > open and prevBear and close >= math.max(open[1], close[1]) and open <= math.min(open[1], close[1])
bearEngulf = close < open and prevBull and close <= math.min(open[1], close[1]) and open >= math.max(open[1], close[1])

// -----------------------------------------------------------------------------
// SETUP LOGIC
// Long : last leg is UP (swing low -> swing high), price retraces into the VA,
//        bullish engulfing confirms. SL = leg origin (Fib 1), TP = target Fib.
// Short: mirror image.
// -----------------------------------------------------------------------------
haveSwings = not na(lastSH) and not na(lastSL)
legRange   = haveSwings ? lastSH - lastSL : na
legUp      = haveSwings and lastSHbar > lastSLbar
legDown    = haveSwings and lastSLbar > lastSHbar

// retracement position: 0 = leg end, 1 = leg origin
fibPosLong  = legUp   and legRange > 0 ? (lastSH - close) / legRange : na
fibPosShort = legDown and legRange > 0 ? (close - lastSL) / legRange : na

inVA(float pos) =>
    not na(pos) and (not i_vaCheck or (pos >= 0.360 and pos <= 0.588)) and pos > 0 and pos < 1

var bool  planActive = false
var int   tradeDir   = 0        // 1 long, -1 short
var int   usedLegBar = na       // prevents more than one plan per leg
var float tEntry     = na
var float tTP        = na
var float tSL        = na
var int   tBar       = na
var int   ctAtEntry  = 0        // closed-trade count when the plan was opened
var box   tpBox      = na
var box   slBox      = na
var line  entryLine  = na
var label entryLbl   = na
var planBoxes  = array.new_box()
var planLines  = array.new_line()
var planLabels = array.new_label()

f_trimBoxes(box[] arr, int maxCount) =>
    while array.size(arr) > maxCount
        box.delete(array.shift(arr))

inDateRange = not i_useDates or (time >= i_startDate and time <= i_endDate)
allowLong   = i_direction != "Short only"
allowShort  = i_direction != "Long only"

canTrade = not planActive and strategy.position_size == 0 and barstate.isconfirmed and inDateRange and invalidToday < i_maxInvalid

legId     = legUp ? lastSHbar : legDown ? lastSLbar : na
freshLeg  = na(usedLegBar) or usedLegBar != legId

longSetup  = allowLong  and canTrade and freshLeg and legUp   and bullEngulf and inVA(fibPosLong)  and asiaLongOk
shortSetup = allowShort and canTrade and freshLeg and legDown and bearEngulf and inVA(fibPosShort) and asiaShortOk
newPlan    = longSetup or shortSetup

if newPlan
    setupsToday += 1
    usedLegBar  := legId
    planActive  := true
    tradeDir    := longSetup ? 1 : -1
    tEntry      := close
    tBar        := bar_index
    ctAtEntry   := strategy.closedtrades
    tSL         := longSetup ? lastSL : lastSH
    tTP         := longSetup ? lastSH - targetFib * legRange : lastSL + targetFib * legRange
    pos          = longSetup ? fibPosLong : fibPosShort
    tag          = "S" + str.tostring(setupsToday)
    right        = bar_index + i_projBars

    // ---- orders ----
    if longSetup
        strategy.entry("Long", strategy.long, comment = tag + " L",
             alert_message = "ACE Model LONG " + syminfo.ticker + " entry " + f_fmt(tEntry) + " TP " + f_fmt(tTP) + " SL " + f_fmt(tSL))
        strategy.exit("Long exit", from_entry = "Long", limit = tTP, stop = tSL, comment_profit = "TP", comment_loss = "SL")
    else
        strategy.entry("Short", strategy.short, comment = tag + " S",
             alert_message = "ACE Model SHORT " + syminfo.ticker + " entry " + f_fmt(tEntry) + " TP " + f_fmt(tTP) + " SL " + f_fmt(tSL))
        strategy.exit("Short exit", from_entry = "Short", limit = tTP, stop = tSL, comment_profit = "TP", comment_loss = "SL")

    // ---- visuals ----
    tpBox := box.new(bar_index, math.max(tEntry, tTP), right, math.min(tEntry, tTP),
         border_color = color.new(color.green, 40), bgcolor = i_tpColor,
         text = tag + " TP" + str.tostring(targetFib) + "  " + f_fmt(tTP), text_color = i_boxTextCol,
         text_size = size.small, text_halign = text.align_left, text_valign = longSetup ? text.align_top : text.align_bottom)
    slBox := box.new(bar_index, math.max(tEntry, tSL), right, math.min(tEntry, tSL),
         border_color = color.new(color.red, 40), bgcolor = i_slColor,
         text = "SL  " + f_fmt(tSL), text_color = i_boxTextCol,
         text_size = size.small, text_halign = text.align_left, text_valign = longSetup ? text.align_bottom : text.align_top)
    entryLine := line.new(bar_index, tEntry, right, tEntry, color = i_entryColor, width = 2)
    entryLbl  := label.new(right, tEntry, tag + " " + str.tostring(pos, "0.000") + "  " + f_fmt(tEntry),
         style = label.style_label_left, color = color.new(i_entryColor, 0), textcolor = color.white, size = size.small)
    array.push(planBoxes, tpBox)
    array.push(planBoxes, slBox)
    array.push(planLines, entryLine)
    array.push(planLabels, entryLbl)
    f_trimBoxes(planBoxes, i_maxPlans * 2)
    f_trimLines(planLines, i_maxPlans)
    f_trimLabels(planLabels, i_maxPlans)

// -----------------------------------------------------------------------------
// TRADE MANAGEMENT - results come from the broker emulator, not re-computed
// -----------------------------------------------------------------------------
var float sumR    = 0.0
var int   countR  = 0

// per-direction stats, index 0 = long, 1 = short
var dTrades = array.new_float(2, 0.0)
var dWins   = array.new_float(2, 0.0)
var dR      = array.new_float(2, 0.0)
var dGrossW = array.new_float(2, 0.0)
var dGrossL = array.new_float(2, 0.0)

// today's stats
var int   tdTrades = 0
var int   tdWins   = 0
var float tdR      = 0.0
var float tdNet    = 0.0
if newDay
    tdTrades := 0
    tdWins   := 0
    tdR      := 0.0
    tdNet    := 0.0

// recent trades log (newest first)
var rcTime = array.new_string()
var rcDir  = array.new_int()
var rcR    = array.new_float()
var rcWin  = array.new_bool()

closedNow = false
wonNow    = false

if planActive and bar_index > tBar
    right = math.max(bar_index, tBar + i_projBars)
    box.set_right(tpBox, right)
    box.set_right(slBox, right)
    line.set_x2(entryLine, right)
    label.set_x(entryLbl, right)

    if strategy.position_size == 0 and strategy.closedtrades <= ctAtEntry
        // entry never filled (e.g. rejected) - drop the plan
        label.set_text(entryLbl, label.get_text(entryLbl) + "  (no fill)")
        planActive := false
    else if strategy.position_size == 0
        lastIdx   = strategy.closedtrades - 1
        exitPx    = strategy.closedtrades.exit_price(lastIdx)
        entryPx   = strategy.closedtrades.entry_price(lastIdx)
        risk      = math.abs(tEntry - tSL)
        rMult     = risk > 0 ? (exitPx - entryPx) * tradeDir / risk : 0.0
        wonNow   := strategy.closedtrades.profit(lastIdx) > 0
        closedNow := true
        pnl       = strategy.closedtrades.profit(lastIdx)
        sumR     += rMult
        countR   += 1

        d = tradeDir == 1 ? 0 : 1
        array.set(dTrades, d, array.get(dTrades, d) + 1)
        array.set(dWins,   d, array.get(dWins, d) + (wonNow ? 1 : 0))
        array.set(dR,      d, array.get(dR, d) + rMult)
        if pnl > 0
            array.set(dGrossW, d, array.get(dGrossW, d) + pnl)
        else
            array.set(dGrossL, d, array.get(dGrossL, d) - pnl)

        tdTrades += 1
        tdWins   += wonNow ? 1 : 0
        tdR      += rMult
        tdNet    += pnl

        array.unshift(rcTime, str.format_time(time, "MM-dd HH:mm", syminfo.timezone))
        array.unshift(rcDir, tradeDir)
        array.unshift(rcR, rMult)
        array.unshift(rcWin, wonNow)
        while array.size(rcTime) > 20
            array.pop(rcTime)
            array.pop(rcDir)
            array.pop(rcR)
            array.pop(rcWin)

        box.set_right(tpBox, bar_index)
        box.set_right(slBox, bar_index)
        line.set_x2(entryLine, bar_index)
        label.set_x(entryLbl, bar_index)
        label.set_text(entryLbl, label.get_text(entryLbl) + (wonNow ? "  ✔ TP " : "  ✖ SL ") + str.tostring(rMult, "+0.00;-0.00") + "R")
        if not wonNow
            invalidToday += 1
        planActive := false

// -----------------------------------------------------------------------------
// PLOTS
// -----------------------------------------------------------------------------
plotshape(longSetup,  "Long setup",  shape.triangleup,   location.belowbar, color.green, size = size.tiny)
plotshape(shortSetup, "Short setup", shape.triangledown, location.abovebar, color.red,   size = size.tiny)

// -----------------------------------------------------------------------------
// STATS TABLE
//   Overall / long / short performance, today's results, the open trade and
//   the most recent closed trades.
// -----------------------------------------------------------------------------
f_tablePos(string s) =>
    switch s
        "Bottom right"  => position.bottom_right
        "Top left"      => position.top_left
        "Bottom left"   => position.bottom_left
        "Middle right"  => position.middle_right
        "Bottom center" => position.bottom_center
        => position.top_right

tblSize  = f_labelSize(i_statsSize)
cHead    = color.new(color.gray, 30)
cText    = color.white
cUp      = color.new(color.lime, 0)
cDn      = color.new(#ff5252, 0)

var table stats = table.new(f_tablePos(i_statsPos), 4, 32, bgcolor = color.new(color.black, 20),
     border_width = 1, border_color = color.new(color.gray, 70), frame_width = 1, frame_color = color.new(color.gray, 40))

f_cell(int c, int r, string txt, color tc, color bg = na) =>
    table.cell(stats, c, r, txt, text_color = tc, text_size = tblSize, bgcolor = bg,
         text_halign = c == 0 ? text.align_left : text.align_right)

f_row4(int r, string a, string b, string c, string d, color ca, color cb, color cc, color cd, color bg = na) =>
    f_cell(0, r, a, ca, bg)
    f_cell(1, r, b, cb, bg)
    f_cell(2, r, c, cc, bg)
    f_cell(3, r, d, cd, bg)

f_sign(float v) =>
    v >= 0 ? color.new(color.lime, 0) : color.new(#ff5252, 0)

f_pct(float w, float n) =>
    n > 0 ? str.tostring(w * 100.0 / n, "0.0") + "%" : "-"

f_pf(float gw, float gl) =>
    gl > 0 ? str.tostring(gw / gl, "0.00") : gw > 0 ? "∞" : "-"

f_rFmt(float v) =>
    str.tostring(v, "+0.00;-0.00")

if i_showStats and barstate.islast
    table.clear(stats, 0, 0, 3, 31)
    allN  = strategy.closedtrades
    lN    = array.get(dTrades, 0)
    sN    = array.get(dTrades, 1)
    lW    = array.get(dWins, 0)
    sW    = array.get(dWins, 1)
    lR    = array.get(dR, 0)
    sR    = array.get(dR, 1)
    lNet  = array.get(dGrossW, 0) - array.get(dGrossL, 0)
    sNet  = array.get(dGrossW, 1) - array.get(dGrossL, 1)
    avgR  = countR > 0 ? sumR / countR : 0.0
    lAvg  = lN > 0 ? lR / lN : 0.0
    sAvg  = sN > 0 ? sR / sN : 0.0
    net   = strategy.netprofit
    r = 0

    // ---- performance ----
    f_row4(r, "ACE Model", "All", "Long", "Short", cText, cText, cText, cText, cHead)
    r += 1
    f_row4(r, "Trades", str.tostring(allN), str.tostring(lN, "0"), str.tostring(sN, "0"), cText, cText, cText, cText)
    r += 1
    f_row4(r, "Wins / Losses", str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades),
         str.tostring(lW, "0") + " / " + str.tostring(lN - lW, "0"), str.tostring(sW, "0") + " / " + str.tostring(sN - sW, "0"),
         cText, cText, cText, cText)
    r += 1
    f_row4(r, "Win rate", f_pct(strategy.wintrades, allN), f_pct(lW, lN), f_pct(sW, sN), cText, cText, cText, cText)
    r += 1
    f_row4(r, "Profit factor", f_pf(strategy.grossprofit, strategy.grossloss),
         f_pf(array.get(dGrossW, 0), array.get(dGrossL, 0)), f_pf(array.get(dGrossW, 1), array.get(dGrossL, 1)),
         cText, cText, cText, cText)
    r += 1
    f_row4(r, "Avg R / trade", f_rFmt(avgR), f_rFmt(lAvg), f_rFmt(sAvg), cText, f_sign(avgR), f_sign(lAvg), f_sign(sAvg))
    r += 1
    f_row4(r, "Total R", f_rFmt(sumR), f_rFmt(lR), f_rFmt(sR), cText, f_sign(sumR), f_sign(lR), f_sign(sR))
    r += 1
    f_row4(r, "Net profit", str.tostring(net, "#,##0"), str.tostring(lNet, "#,##0"), str.tostring(sNet, "#,##0"),
         cText, f_sign(net), f_sign(lNet), f_sign(sNet))
    r += 1
    f_row4(r, "Max drawdown", str.tostring(strategy.max_drawdown, "#,##0"), "", "", cText, cDn, cText, cText)
    r += 1

    // ---- today ----
    f_row4(r, "Today", str.tostring(tdTrades) + " trades", str.tostring(tdWins) + " W / " + str.tostring(tdTrades - tdWins) + " L",
         f_rFmt(tdR) + "R", cText, cText, cText, f_sign(tdR), cHead)
    r += 1

    // ---- open trade ----
    if planActive and strategy.position_size != 0
        openPnl = strategy.openprofit
        f_row4(r, "Open " + (tradeDir == 1 ? "LONG" : "SHORT"), "E " + f_fmt(tEntry), "TP " + f_fmt(tTP) + " / SL " + f_fmt(tSL),
             str.tostring(openPnl, "#,##0"), cText, cText, cText, f_sign(openPnl))
    else
        f_row4(r, "Open trade", "flat", "", "", cText, cText, cText, cText)
    r += 1

    // ---- recent trades ----
    shown = math.min(i_recentN, array.size(rcTime))
    if i_recentN > 0
        f_row4(r, "Recent trades", "Dir", "R", "Result", cText, cText, cText, cText, cHead)
        r += 1
        if shown == 0
            f_row4(r, "none yet", "", "", "", cText, cText, cText, cText)
        else
            for i = 0 to shown - 1
                w = array.get(rcWin, i)
                f_row4(r + i, array.get(rcTime, i), array.get(rcDir, i) == 1 ? "Long" : "Short",
                     f_rFmt(array.get(rcR, i)), w ? "✔ TP" : "✖ SL", cText, cText, f_sign(array.get(rcR, i)), w ? cUp : cDn)

// -----------------------------------------------------------------------------
// ALERTS (strategies support alert() calls and order-fill alerts)
// -----------------------------------------------------------------------------
if i_alertSwing and newSH
    alert("ACE Model: new swing high " + f_fmt(ph) + " on " + syminfo.ticker, alert.freq_once_per_bar_close)
if i_alertSwing and newSL
    alert("ACE Model: new swing low " + f_fmt(pl) + " on " + syminfo.ticker, alert.freq_once_per_bar_close)
if i_alertSwing and closedNow
    alert("ACE Model: trade closed at " + (wonNow ? "TP" : "SL") + " on " + syminfo.ticker, alert.freq_once_per_bar_close)
if i_alertPlan and newPlan
    alert("ACE Model: new " + (longSetup ? "LONG" : "SHORT") + " plan on " + syminfo.ticker +
         " | Entry " + f_fmt(tEntry) + " | TP " + f_fmt(tTP) + " | SL " + f_fmt(tSL), alert.freq_once_per_bar_close)

//@version=5
// ═══════════════════════════════════════════════════════════════════════════════
//  MNQ LIQUIDITY SWEEP — SUPPORT REJECTION SCALPER  (STRATEGY v2)
// ═══════════════════════════════════════════════════════════════════════════════
//  IDEA (what you see on the chart):
//   1. A blue KEY SUPPORT ZONE sits under price (a confirmed swing low).
//   2. A candle spikes BELOW that zone (stop-losses / sell-side liquidity get
//      grabbed) but CLOSES BACK ABOVE it with a real rejection wick
//      ->  the "TRAP" / trigger candle.
//   3. When the trigger candle closes, we buy at the OPEN of the next candle.
//   4. Stop Loss goes under the trigger candle's wick (never tighter than a
//      fraction of ATR, so normal noise can't knock us out).
//      Take Profit = Entry + (Risk x RR)  (default 1:3).
//   5. Gray RISK box + blue REWARD box, red SL line + green TP line.
//
//  v2 CHANGES (fixes found from live chart review):
//   • Support = last CONFIRMED SWING LOW (pivot) instead of a rolling lowest
//     low — in downtrends the rolling low kept creating fake "supports".
//   • Each support level can be traded ONCE. A candle CLOSING below it kills it
//     (that's an accepted breakdown, not a sweep).
//   • Rejection quality: min lower-wick % and close in the upper part of the
//     candle. A 1-tick poke below support is no longer a "trap".
//   • Min sweep depth + max sweep depth (too deep = real breakdown).
//   • ATR-based stops: SL is never tighter than X * ATR and never wider than
//     Y * ATR. (Tick-based max risk filtered OUT the good setups on 5m.)
//   • Trend filter (EMA), cooldown after a loss, daily loss limit.
//   • Optional breakeven move.
//   • Cleaner chart: no overlapping text.
//
//  Designed for the 1-minute chart (MNQ / NQ). If you run it on 5m, the
//  ATR-based settings adapt automatically.
//  ALERTS: create an alert on this strategy -> "alert() function calls only".
// ═══════════════════════════════════════════════════════════════════════════════
strategy(title = "MNQ Liquidity Sweep",
     shorttitle = "MNQ Sweep",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     pyramiding = 0,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.62,
     slippage = 1,
     calc_on_every_tick = true,
     process_orders_on_close = false,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500)

// calc_on_every_tick = true lets the "setup forming" alert fire intrabar.
// Every ORDER is still gated by barstate.isconfirmed (closed candles only),
// so live behaviour matches the backtest.


// ═══════════════════════════════════════════════════════════════════════════════
// --- USER INPUTS ---
// ═══════════════════════════════════════════════════════════════════════════════

// --- 1) KEY SUPPORT ZONE (the blue zone) ---
string GRP_SUP     = "1) Key Support Zone"
string supportMode = input.string("Swing Pivot", "Support Method", options = ["Swing Pivot", "Lowest Low"], group = GRP_SUP, tooltip = "Swing Pivot (recommended): the last confirmed swing low. Lowest Low: lowest low of the previous N bars (v1 behaviour — creates many fake supports in downtrends).")
int    pivLeft     = input.int(10, "Swing Pivot: Left Bars", minval = 1, group = GRP_SUP, tooltip = "A swing low needs this many higher lows to its LEFT.")
int    pivRight    = input.int(5, "Swing Pivot: Right Bars", minval = 1, group = GRP_SUP, tooltip = "...and this many higher lows to its RIGHT (confirmation delay).")
int    minLevelAge = input.int(10, "Min Level Age (bars)", minval = 0, group = GRP_SUP, tooltip = "The swing low must be at least this old so stops have had time to pile up under it.")
int    supportLen  = input.int(30, "Lowest Low: Lookback (bars)", minval = 2, group = GRP_SUP)
int    zoneTicks   = input.int(4, "Zone Thickness (ticks above level)", minval = 0, group = GRP_SUP, tooltip = "Visual only.")

// --- 2) TRIGGER CANDLE (the Trap) ---
string GRP_TRG       = "2) Trigger Candle (The Trap)"
int    minSweepTicks = input.int(4, "Min Sweep Depth (ticks below support)", minval = 1, group = GRP_TRG, tooltip = "Wick must pierce support by at least this much. MNQ: 4 ticks = 1 point.")
float  maxSweepAtr   = input.float(1.5, "Max Sweep Depth (x ATR, 0 = off)", minval = 0, step = 0.25, group = GRP_TRG, tooltip = "If the wick goes deeper than this it is a real breakdown, not a stop hunt.")
int    minWickPct    = input.int(40, "Min Lower Wick (% of candle range)", minval = 0, maxval = 100, group = GRP_TRG, tooltip = "The rejection wick must be a meaningful part of the candle.")
int    minClosePos   = input.int(50, "Close in Upper % of Candle", minval = 0, maxval = 100, group = GRP_TRG, tooltip = "50 = the close must be in the upper half of the candle (buyers won).")

// --- 3) RISK MANAGEMENT ---
string GRP_RSK       = "3) Risk Management"
int    qtyContracts  = input.int(1, "Contracts", minval = 1, group = GRP_RSK)
int    rrRatio       = input.int(3, "Risk : Reward  (1 : X)", minval = 1, maxval = 20, group = GRP_RSK)
int    slBufferTicks = input.int(4, "SL Buffer Below Wick (ticks)", minval = 0, group = GRP_RSK)
int    atrLen        = input.int(14, "ATR Length", minval = 1, group = GRP_RSK)
float  minStopAtr    = input.float(0.75, "Min Stop Distance (x ATR)", minval = 0, step = 0.25, group = GRP_RSK, tooltip = "If the wick stop is tighter than this, the SL is pushed lower. Stops of 2-4 points on NQ get hit by pure noise.")
float  maxStopAtr    = input.float(3.0, "Max Stop Distance (x ATR, 0 = off)", minval = 0, step = 0.25, group = GRP_RSK, tooltip = "Skip setups whose stop would be wider than this.")
float  beAtR         = input.float(0.0, "Move SL to Breakeven at (R) — 0 = off", minval = 0, step = 0.5, group = GRP_RSK, tooltip = "e.g. 1.5 = once price reaches +1.5R, the stop moves to entry + 1 tick.")
int    projBars      = input.int(20, "R/R Box Projection (bars)", minval = 1, group = GRP_RSK)

// --- 4) FILTERS ---
string GRP_FLT        = "4) Filters"
bool   useTrend       = input.bool(true, "Trend Filter: only long above EMA", group = GRP_FLT)
int    emaLen         = input.int(200, "Trend EMA Length", minval = 1, group = GRP_FLT)
int    cooldownBars   = input.int(10, "Cooldown After a Loss (bars)", minval = 0, group = GRP_FLT)
int    maxDailyLosses = input.int(3, "Max Losses per Day (0 = off)", minval = 0, group = GRP_FLT)
bool   useSession     = input.bool(false, "Trade Only Inside Session", group = GRP_FLT)
string sessTime       = input.session("0930-1600", "Session (New York time)", group = GRP_FLT)
bool   flatOutside    = input.bool(true, "Flatten Position When Session Ends", group = GRP_FLT)

// --- 5) VISUALS ---
string GRP_VIS     = "5) Visuals"
bool   showBoxText = input.bool(true, "Show SL/TP Prices in Boxes", group = GRP_VIS)
bool   showEma     = input.bool(true, "Plot Trend EMA", group = GRP_VIS)
bool   showSupHist = input.bool(true, "Plot Support History", group = GRP_VIS)
color  colSupFill  = input.color(color.new(color.blue, 80), "Support Zone Fill", group = GRP_VIS)
color  colSupLine  = input.color(color.blue, "Support Zone Border", group = GRP_VIS)
color  colReward   = input.color(color.new(color.blue, 82), "Reward Box", group = GRP_VIS)
color  colRisk     = input.color(color.new(color.gray, 72), "Risk Box", group = GRP_VIS)
color  colSL       = input.color(color.red, "Stop Loss Line", group = GRP_VIS)
color  colTP       = input.color(color.green, "Take Profit Line", group = GRP_VIS)


// ═══════════════════════════════════════════════════════════════════════════════
// --- HELPERS & BASE SERIES ---
// ═══════════════════════════════════════════════════════════════════════════════
float tickSize = syminfo.mintick

// Round a price DOWN to the nearest valid tick (stops must sit on real prices).
roundDown(float p) =>
    math.floor(p / syminfo.mintick) * syminfo.mintick

float atrVal   = ta.atr(atrLen)
float emaTrend = ta.ema(close, emaLen)
bool  useLL    = supportMode == "Lowest Low"

// Session gate.
bool inSession = not useSession or not na(time(timeframe.period, sessTime, "America/New_York"))

// New trading day -> reset the daily loss counter.
bool newDay = ta.change(time("D")) != 0


// ═══════════════════════════════════════════════════════════════════════════════
// --- MARKET CONTEXT & SUPPORT ZONE IDENTIFICATION ---
// ═══════════════════════════════════════════════════════════════════════════════

// Method A — rolling lowest low of the PREVIOUS N bars ([1] excludes this bar).
float llSupport = ta.lowest(low, supportLen)[1]

// Method B — confirmed swing low. ta.pivotlow() returns a value only when a
// swing low is CONFIRMED (pivRight bars after it formed); otherwise na.
float pivotFound = ta.pivotlow(low, pivLeft, pivRight)

// Persistent state for the active swing-low level.
var float pivLevel  = na      // price of the active swing low
var int   pivBar    = na      // bar_index where that swing low printed
var bool  levelUsed = false   // true once a trade was taken off this level

// The support used by the trigger logic (value as of the START of this bar).
float support    = useLL ? llSupport : pivLevel
bool  levelAgeOK = useLL or (not na(pivBar) and bar_index - pivBar >= minLevelAge)
bool  levelFree  = useLL or not levelUsed


// ═══════════════════════════════════════════════════════════════════════════════
// --- DETECTING THE LIQUIDITY SWEEP (THE TRAP CANDLE) ---
// ═══════════════════════════════════════════════════════════════════════════════
float candleRange = high - low
float lowerWick   = math.min(open, close) - low
float sweepDepth  = support - low

// STEP A — Wick below support by at least `minSweepTicks` (the stop hunt).
bool sweepForming = not na(support) and sweepDepth >= minSweepTicks * tickSize

// STEP B — Not too deep (a huge flush through the level is a real breakdown).
bool depthOK = maxSweepAtr == 0 or sweepDepth <= maxSweepAtr * atrVal

// STEP C — Real rejection: long lower wick and close in the upper part of the bar.
bool wickOK  = candleRange > 0 and lowerWick / candleRange * 100 >= minWickPct
bool closeOK = candleRange > 0 and (close - low) / candleRange * 100 >= minClosePos

// STEP D — Close back ABOVE support (failed breakdown).
bool triggerCandle = sweepForming and depthOK and wickOK and closeOK and close > support and levelAgeOK and levelFree


// ═══════════════════════════════════════════════════════════════════════════════
// --- STOP LOSS / RISK CALCULATION ---
// ═══════════════════════════════════════════════════════════════════════════════
// Natural stop: under the trigger wick minus a tick buffer.
float naturalSL   = low - slBufferTicks * tickSize
// ATR floor: never risk less than minStopAtr x ATR (noise protection).
float minStopDist = minStopAtr * atrVal
float sigSL       = roundDown((close - naturalSL) < minStopDist ? close - minStopDist : naturalSL)
float estRisk     = close - sigSL
bool  riskOK      = estRisk > 0 and (maxStopAtr == 0 or estRisk <= maxStopAtr * atrVal)


// ═══════════════════════════════════════════════════════════════════════════════
// --- FILTERS: TREND, COOLDOWN, DAILY LOSS LIMIT ---
// ═══════════════════════════════════════════════════════════════════════════════
var int lossesToday = 0
var int lastLossBar = na
if newDay
    lossesToday := 0

bool trendOK    = not useTrend or close > emaTrend
bool cooldownOK = na(lastLossBar) or bar_index - lastLossBar > cooldownBars
bool dailyOK    = maxDailyLosses == 0 or lossesToday < maxDailyLosses

// FINAL LONG SETUP — only on a CLOSED trigger candle, while flat.
bool longSetup = triggerCandle and riskOK and trendOK and cooldownOK and dailyOK and inSession and strategy.position_size == 0 and barstate.isconfirmed


// ═══════════════════════════════════════════════════════════════════════════════
// --- PERSISTENT TRADE STATE ---
// ═══════════════════════════════════════════════════════════════════════════════
var float tradeSL     = na
var float tradeTP     = na
var float tradeEntry  = na
var float trigLow     = na
var bool  tracking    = false
var bool  beDone      = false
var int   entryBarIdx = na
var box   rewardBox   = na
var box   riskBox     = na
var line  slLine      = na
var line  tpLine      = na


// ═══════════════════════════════════════════════════════════════════════════════
// --- ENTRY: SENT WHEN THE TRIGGER CANDLE CLOSES (fills next candle's open) ---
// ═══════════════════════════════════════════════════════════════════════════════
if longSetup
    tradeSL := sigSL
    trigLow := low
    float estTP = math.round_to_mintick(close + rrRatio * estRisk)
    strategy.entry("Long", strategy.long, qty = qtyContracts, comment = "Long")
    // Bracket attached immediately so the entry candle is protected.
    strategy.exit("Long Exit", from_entry = "Long", stop = sigSL, limit = estTP, comment_loss = "SL", comment_profit = "TP")
    if not useLL
        levelUsed := true   // one trade per swing level
    // --- ALERT: LONG ENTRY TRIGGER ---
    alert("MNQ Sweep | LONG ENTRY on " + syminfo.ticker + " | Buy next open | SL " + str.tostring(sigSL, format.mintick) + " | TP ~" + str.tostring(estTP, format.mintick) + " | RR 1:" + str.tostring(rrRatio), alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// --- SUPPORT LEVEL MAINTENANCE (runs AFTER the trigger check) ---
// ═══════════════════════════════════════════════════════════════════════════════
if not useLL and barstate.isconfirmed
    // A CLOSE below the level = accepted breakdown -> level is dead.
    if not na(pivLevel) and close < pivLevel
        pivLevel  := na
        pivBar    := na
    // A newly confirmed swing low becomes the new key support.
    if not na(pivotFound)
        pivLevel  := pivotFound
        pivBar    := bar_index - pivRight
        levelUsed := false


// ═══════════════════════════════════════════════════════════════════════════════
// --- DETECTING THE FILL (ENTRY CANDLE) & RE-CENTRING SL/TP ---
// ═══════════════════════════════════════════════════════════════════════════════
int  tradeCount = strategy.opentrades + strategy.closedtrades
bool newTrade   = tradeCount > nz(tradeCount[1])

if newTrade
    tradeEntry := strategy.opentrades > 0 ? strategy.opentrades.entry_price(strategy.opentrades - 1) : strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    tradeTP    := math.round_to_mintick(tradeEntry + rrRatio * (tradeEntry - tradeSL))
    beDone     := false

    if strategy.position_size > 0 and barstate.isconfirmed
        // Entry candle must open ABOVE the trigger low, otherwise invalid.
        if open <= trigLow
            strategy.close("Long", comment = "Invalid")
        else
            strategy.exit("Long Exit", from_entry = "Long", stop = tradeSL, limit = tradeTP, comment_loss = "SL", comment_profit = "TP")

    // --- RISK / REWARD BOXES + SL / TP LINES ---
    int rightEdge = bar_index + projBars
    rewardBox := box.new(bar_index, tradeTP, rightEdge, tradeEntry, border_color = color.new(colTP, 50), bgcolor = colReward, text = showBoxText ? "TP " + str.tostring(tradeTP, format.mintick) : "", text_size = size.tiny, text_color = colTP, text_halign = text.align_right, text_valign = text.align_top)
    riskBox   := box.new(bar_index, tradeEntry, rightEdge, tradeSL, border_color = color.new(colSL, 50), bgcolor = colRisk, text = showBoxText ? "SL " + str.tostring(tradeSL, format.mintick) : "", text_size = size.tiny, text_color = colSL, text_halign = text.align_right, text_valign = text.align_bottom)
    slLine    := line.new(bar_index, tradeSL, rightEdge, tradeSL, color = colSL, width = 2)
    tpLine    := line.new(bar_index, tradeTP, rightEdge, tradeTP, color = colTP, width = 2)
    tracking    := true
    entryBarIdx := bar_index


// ═══════════════════════════════════════════════════════════════════════════════
// --- OPTIONAL BREAKEVEN MOVE ---
// ═══════════════════════════════════════════════════════════════════════════════
if beAtR > 0 and strategy.position_size > 0 and not beDone and barstate.isconfirmed and high >= tradeEntry + beAtR * (tradeEntry - tradeSL)
    float beStop = tradeEntry + tickSize
    strategy.exit("Long Exit", from_entry = "Long", stop = beStop, limit = tradeTP, comment_loss = "BE", comment_profit = "TP")
    line.set_y1(slLine, beStop)
    line.set_y2(slLine, beStop)
    beDone := true


// ═══════════════════════════════════════════════════════════════════════════════
// --- LIVE TRADE VISUALS & EXIT MARKERS ---
// ═══════════════════════════════════════════════════════════════════════════════
if tracking
    int edge = math.max(entryBarIdx + projBars, bar_index)
    box.set_right(rewardBox, edge)
    box.set_right(riskBox, edge)
    line.set_x2(slLine, edge)
    line.set_x2(tpLine, edge)

    if strategy.position_size == 0
        tracking := false
        box.set_right(rewardBox, bar_index)
        box.set_right(riskBox, bar_index)
        line.set_x2(slLine, bar_index)
        line.set_x2(tpLine, bar_index)
        int   lastIdx = strategy.closedtrades - 1
        float pnl     = strategy.closedtrades.profit(lastIdx)
        float exitPx  = strategy.closedtrades.exit_price(lastIdx)
        // Loss bookkeeping for cooldown + daily limit.
        if pnl < 0
            lossesToday += 1
            lastLossBar := bar_index
        string res = pnl > 0 and exitPx >= tradeTP - tickSize ? "✔" : pnl > 0 ? "BE" : "✖"
        label.new(bar_index, exitPx, res, style = pnl > 0 ? label.style_label_down : label.style_label_up, color = pnl > 0 ? colTP : colSL, textcolor = color.white, size = size.tiny)


// ═══════════════════════════════════════════════════════════════════════════════
// --- SESSION END: FLATTEN ---
// ═══════════════════════════════════════════════════════════════════════════════
if useSession and flatOutside and not inSession and strategy.position_size > 0 and barstate.isconfirmed
    strategy.close_all(comment = "EOD")


// ═══════════════════════════════════════════════════════════════════════════════
// --- KEY SUPPORT ZONE BOX (blue, extended right) ---
// ═══════════════════════════════════════════════════════════════════════════════
float curSupport = useLL ? llSupport : pivLevel
int   zoneLeft   = useLL ? bar_index - supportLen : nz(pivBar, bar_index)
var box supBox = na
if not na(curSupport)
    if na(supBox)
        supBox := box.new(zoneLeft, curSupport + zoneTicks * tickSize, bar_index, curSupport, border_color = colSupLine, bgcolor = colSupFill, extend = extend.right, text = "Key Support", text_size = size.tiny, text_color = colSupLine, text_halign = text.align_right)
    else
        box.set_lefttop(supBox, zoneLeft, curSupport + zoneTicks * tickSize)
        box.set_rightbottom(supBox, bar_index, curSupport)
        box.set_extend(supBox, extend.right)
else if not na(supBox)
    // Level was broken -> hide the zone until a new swing low confirms.
    box.set_extend(supBox, extend.none)
    box.set_right(supBox, bar_index)

plot(showSupHist ? curSupport : na, "Support Level", color = color.new(color.blue, 40), style = plot.style_linebr)
plot(showEma and useTrend ? emaTrend : na, "Trend EMA", color = color.new(color.orange, 30))


// ═══════════════════════════════════════════════════════════════════════════════
// --- CHART SIGNALS ---
// ═══════════════════════════════════════════════════════════════════════════════
// Small orange diamond = valid trap candle (taken or filtered out by trend/cooldown).
plotshape(triggerCandle and barstate.isconfirmed, "Trap Candle", shape.diamond, location.belowbar, color.orange, size = size.tiny)
// Green arrow = the confirmation candle where the long was filled.
plotshape(newTrade, "Buy", shape.triangleup, location.belowbar, color.green, size = size.small)


// ═══════════════════════════════════════════════════════════════════════════════
// --- ALERT: SETUP FORMING (price wicking below support right now) ---
// ═══════════════════════════════════════════════════════════════════════════════
if sweepForming and levelFree and strategy.position_size == 0 and inSession
    alert("MNQ Sweep | SETUP FORMING on " + syminfo.ticker + " | Wick below support " + str.tostring(support, format.mintick) + " | Watch for close back above", alert.freq_once_per_bar)


// ═══════════════════════════════════════════════════════════════════════════════
// --- TIMEFRAME CHECK (bottom-right, so it never covers the symbol title) ---
// ═══════════════════════════════════════════════════════════════════════════════
var table infoTbl = table.new(position.bottom_right, 1, 1, bgcolor = color.new(color.black, 30))
if barstate.islast
    bool   isOneMin = timeframe.period == "1"
    string tfMsg    = isOneMin ? "MNQ Sweep • 1m ✔ • RR 1:" + str.tostring(rrRatio) : "⚠ Built for 1m (current: " + timeframe.period + ")"
    table.cell(infoTbl, 0, 0, tfMsg, text_color = isOneMin ? color.white : color.orange, text_size = size.small)

//@version=5
// ============================================================================
//  EMA + VWAP Intraday Scalper
// ----------------------------------------------------------------------------
//  Rules
//   • Bias      : EMA crosses OVER the daily VWAP  -> long bias
//                 EMA crosses UNDER the daily VWAP -> short bias
//   • Long entry: long bias, the candle's LOW wicks below VWAP, and the candle
//                 CLOSES above VWAP.
//   • Short entry: short bias, the candle's HIGH wicks above VWAP, and the
//                 candle CLOSES below VWAP.
//   • Exit long : a candle closes below the EMA.
//   • Exit short: a candle closes above the EMA.
//   • No fixed take profit or stop loss.
//
//  Built for a 3-minute chart. Signals are evaluated on confirmed bar closes
//  and orders fill at the next bar's open, so the backtest does not repaint.
//
//  Trading costs: TradingView does not let inputs change commission or
//  slippage, so they are set in strategy() below. Change them in
//  Settings -> Properties ("Commission" and "Slippage").
// ============================================================================
strategy("EMA + VWAP Scalper", shorttitle = "EMA/VWAP Scalp", overlay = true,
     pyramiding               = 0,
     initial_capital          = 10000,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 100,
     commission_type          = strategy.commission.cash_per_contract,
     commission_value         = 2.5,      // $ per contract per side (futures); edit in Properties.
                                          // For stocks, switch to a percent commission instead.
     slippage                 = 1,        // ticks per fill; edit in Properties
     calc_on_every_tick       = false,    // evaluate on bar close only
     process_orders_on_close  = false,    // fill at the next bar's open
     margin_long              = 0,        // 0 = no margin check. With 100%, 1 NQ contract
     margin_short             = 0)        // (~$560k notional) is rejected on a $10k account.

// ─── Inputs ─────────────────────────────────────────────────────────────────
grpInd   = "Indicators"
emaLen   = input.int(9, "EMA Length", minval = 1, group = grpInd)
slowLen  = input.int(21, "Slow EMA Length", minval = 1, group = grpInd,
     tooltip = "Second, slower EMA (21 by default). Plotted on the chart; can also be used as a trend filter and/or as the exit line.")
showSlow = input.bool(true, "Show Slow EMA", group = grpInd)
emaSrc   = input.source(close, "EMA Source", group = grpInd)
vwapSrc  = input.source(hlc3, "VWAP Source", group = grpInd)
vwapAnchor = input.string("Daily (exchange session)", "VWAP Anchor", options = ["Daily (exchange session)", "Session start (uses Session below)"], group = grpInd,
     tooltip = "Futures like NQ start their daily session at 18:00 New York time. Choose 'Session start' to reset VWAP at the cash open instead (e.g. 09:30).")

grpTrade = "Trading"
allowLong  = input.bool(true, "Allow Longs", group = grpTrade)
allowShort = input.bool(true, "Allow Shorts", group = grpTrade)
sizeMode   = input.string("Fixed Quantity", "Order Size Mode", options = ["% of Equity", "Fixed Quantity"], group = grpTrade)
equityPct  = input.float(100.0, "% of Equity per Trade", minval = 0.1, maxval = 100, step = 1, group = grpTrade)
fixedQty   = input.float(1.0, "Fixed Quantity (shares/contracts)", minval = 0.0001, group = grpTrade,
     tooltip = "Default sizing. For futures on a small account use 1 contract (MNQ is $2/point, NQ is $20/point).")
useSession = input.bool(false, "Only Take Entries Inside Session", group = grpTrade)
sessionStr = input.session("0930-1600", "Session", group = grpTrade)
sessionTz  = input.string("America/New_York", "Session Time Zone", options = ["America/New_York", "America/Chicago", "Europe/London", "UTC"], group = grpTrade,
     tooltip = "CME futures use Chicago time by default, so set the session's time zone here explicitly.")
flatEOD    = input.bool(false, "Close Open Trades When Session Ends", group = grpTrade,
     tooltip = "Optional. Uses the Session above. Off by default so exits follow the EMA rule only.")

grpFilt     = "Filters (all off by default)"
resetBias   = input.bool(true, "Require Fresh EMA/VWAP Cross Each Day", group = grpFilt,
     tooltip = "Clears the bias when VWAP resets, so yesterday's crossover cannot trigger trades right after the reset.")
skipBars    = input.int(0, "Skip Bars After VWAP Reset", minval = 0, group = grpFilt,
     tooltip = "Right after a reset VWAP sits on top of price and wicks pierce it on almost every bar.")
minSepTicks = input.int(0, "Min EMA/VWAP Separation (ticks)", minval = 0, group = grpFilt,
     tooltip = "Skips entries when EMA and VWAP are tangled together (choppy, sideways markets).")
needEmaSide = input.bool(false, "Entry Candle Must Also Close Beyond EMA", group = grpFilt,
     tooltip = "Avoids entries that would be exited on the very next bar by the EMA rule.")
useStack    = input.bool(false, "EMA Trend Filter (9 vs 21)", group = grpFilt,
     tooltip = "Longs only when the fast EMA is above the slow EMA; shorts only when below.")
useHtf      = input.bool(false, "Higher-Timeframe Trend Filter", group = grpFilt,
     tooltip = "Longs only when the higher-timeframe close is above its EMA; shorts only when below. Uses the last COMPLETED higher-timeframe bar, so it does not repaint.")
htfTF       = input.timeframe("15", "  HTF Timeframe", group = grpFilt)
htfLen      = input.int(50, "  HTF EMA Length", minval = 1, group = grpFilt)

grpExit     = "Exit"
exitLine    = input.string("Fast EMA (9)", "Exit Line", options = ["Fast EMA (9)", "Slow EMA (21)"], group = grpExit,
     tooltip = "Fast = original rule. Slow = exit on closes beyond the 21 EMA, giving trends more room (bigger winners, bigger losers).")
exitBars    = input.int(1, "Closes Beyond EMA Needed to Exit", minval = 1, maxval = 10, group = grpExit,
     tooltip = "1 = original rule (exit on the first close beyond the EMA). 2 = wait for two closes in a row, which keeps winners in strong trends longer but lets losers run a little further.")

grpTF      = "Timeframe"
intendedTF = input.timeframe("3", "Intended Chart Timeframe", group = grpTF,
     tooltip = "Strategies run on the chart's timeframe. A warning shows if the chart does not match this value.")

grpAlert   = "Alerts"
useAlerts  = input.bool(true, "Enable Alerts", group = grpAlert)

grpVis     = "Visuals"
showBiasBg = input.bool(true, "Shade Background by Bias", group = grpVis)
showMarks  = input.bool(true, "Show Signal Markers", group = grpVis)

// ─── Indicators ─────────────────────────────────────────────────────────────
// EMA
emaVal  = ta.ema(emaSrc, emaLen)
slowVal = ta.ema(emaSrc, slowLen)
exitVal = exitLine == "Slow EMA (21)" ? slowVal : emaVal
stackUp   = not useStack or emaVal > slowVal
stackDown = not useStack or emaVal < slowVal

// Session membership (time zone set explicitly; exchange time differs for futures).
inSessNow = not na(time(timeframe.period, sessionStr, sessionTz))
sessStart = inSessNow and not inSessNow[1]

// VWAP: anchored to each new trading day, or to the session open if chosen.
newDay     = timeframe.change("D")
vwapReset  = vwapAnchor == "Daily (exchange session)" ? newDay : sessStart
vwapVal    = ta.vwap(vwapSrc, vwapReset)
barsSinceReset = ta.barssince(vwapReset)

// Higher-timeframe trend: values from the previous completed HTF bar.
// The [1] offset combined with lookahead_on is the standard non-repainting form.
[htfClose, htfEma] = request.security(syminfo.tickerid, htfTF, [close[1], ta.ema(close, htfLen)[1]], lookahead = barmerge.lookahead_on)
htfUp   = not useHtf or (not na(htfEma) and htfClose > htfEma)
htfDown = not useHtf or (not na(htfEma) and htfClose < htfEma)

// ─── Bias (set by EMA/VWAP crossovers) ──────────────────────────────────────
// bias:  1 = long, -1 = short, 0 = no crossover seen yet.
var int bias = 0
crossUp   = ta.crossover(emaVal, vwapVal)
crossDown = ta.crossunder(emaVal, vwapVal)
if resetBias and vwapReset
    bias := 0
if crossUp
    bias := 1
else if crossDown
    bias := -1

longBias  = bias == 1  and emaVal > vwapVal
shortBias = bias == -1 and emaVal < vwapVal

// ─── Entry rules (the "wick" rule) ──────────────────────────────────────────
// Long : low pierces below VWAP, close finishes above VWAP.
// Short: high pierces above VWAP, close finishes below VWAP.
longWick  = low  < vwapVal and close > vwapVal
shortWick = high > vwapVal and close < vwapVal

inSession  = not useSession or inSessNow
afterReset = na(barsSinceReset) or barsSinceReset >= skipBars
separated  = math.abs(emaVal - vwapVal) >= minSepTicks * syminfo.mintick
filtersOk  = inSession and afterReset and separated and barstate.isconfirmed

longSignal  = allowLong  and longBias  and longWick  and filtersOk and htfUp   and stackUp   and (not needEmaSide or close > emaVal)
shortSignal = allowShort and shortBias and shortWick and filtersOk and htfDown and stackDown and (not needEmaSide or close < emaVal)

// ─── Exit rules (the "EMA break" rule) ──────────────────────────────────────
// Count consecutive closes on each side of the EMA.
var int closesBelow = 0
var int closesAbove = 0
closesBelow := close < exitVal ? closesBelow + 1 : 0
closesAbove := close > exitVal ? closesAbove + 1 : 0

exitLongSignal  = strategy.position_size > 0 and closesBelow >= exitBars
exitShortSignal = strategy.position_size < 0 and closesAbove >= exitBars

// Optional end-of-session flatten: true on the first bar after the session
// closes (the close order fills at the next bar's open).
sessionEnded = flatEOD and inSessNow[1] and not inSessNow

// ─── Order sizing ───────────────────────────────────────────────────────────
// Returns the quantity for a new entry based on the chosen mode.
// Uses the contract's point value (NQ = $20/point), and whole contracts for
// futures. With $10k on NQ, % of equity rounds to 0 contracts: use Fixed
// Quantity (or MNQ, $2/point) instead.
isFutures = syminfo.type == "futures"
orderQty() =>
    float q = sizeMode == "Fixed Quantity" ? fixedQty : (strategy.equity * equityPct / 100.0) / (close * syminfo.pointvalue)
    isFutures ? math.floor(q) : q

// Webhook-friendly JSON payload.
payload(string action) =>
    '{"action":"' + action + '","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close, format.mintick) +
     ',"ema":' + str.tostring(emaVal, format.mintick) + ',"vwap":' + str.tostring(vwapVal, format.mintick) + '}'

// ─── Orders ─────────────────────────────────────────────────────────────────
// Exits are processed first so a bar that closes through the EMA flattens
// the position before any new signal is considered.
if exitLongSignal
    strategy.close("Long", comment = "Close < EMA")
    if useAlerts
        alert(payload("exit_long"), alert.freq_once_per_bar_close)

if exitShortSignal
    strategy.close("Short", comment = "Close > EMA")
    if useAlerts
        alert(payload("exit_short"), alert.freq_once_per_bar_close)

if sessionEnded and strategy.position_size != 0
    strategy.close_all(comment = "Session end")
    if useAlerts
        alert(payload("exit_all"), alert.freq_once_per_bar_close)

// Markers show real entries only, not every bar where the conditions hold.
bool tookLong  = false
bool tookShort = false
bool sizeZero  = false

if longSignal and strategy.position_size <= 0 and orderQty() <= 0
    sizeZero := true
if shortSignal and strategy.position_size >= 0 and orderQty() <= 0
    sizeZero := true

if longSignal and strategy.position_size <= 0 and orderQty() > 0
    tookLong := true
    strategy.entry("Long", strategy.long, qty = orderQty(), comment = "VWAP wick long")
    if useAlerts
        alert(payload("buy"), alert.freq_once_per_bar_close)

if shortSignal and strategy.position_size >= 0 and orderQty() > 0
    tookShort := true
    strategy.entry("Short", strategy.short, qty = orderQty(), comment = "VWAP wick short")
    if useAlerts
        alert(payload("sell"), alert.freq_once_per_bar_close)

// ─── Plots ──────────────────────────────────────────────────────────────────
plot(emaVal,  "EMA",  color = color.new(color.orange, 0), linewidth = 2)
plot(showSlow ? slowVal : na, "Slow EMA", color = color.new(color.fuchsia, 0), linewidth = 2)
plot(useHtf ? htfEma : na, "HTF EMA", color = color.new(color.purple, 30), linewidth = 1, style = plot.style_stepline)
plot(vwapVal, "VWAP", color = color.new(color.blue, 0),   linewidth = 2, style = plot.style_linebr)

bgcolor(showBiasBg and longBias  ? color.new(color.green, 92) : na, title = "Long Bias")
bgcolor(showBiasBg and shortBias ? color.new(color.red,   92) : na, title = "Short Bias")

plotshape(showMarks and tookLong,  "Long Entry",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(showMarks and tookShort, "Short Entry", shape.triangledown, location.abovebar, color.red,   size = size.small)
plotshape(showMarks and exitLongSignal,  "Long Exit",  shape.xcross, location.abovebar, color.new(color.green, 30), size = size.tiny)
plotshape(showMarks and exitShortSignal, "Short Exit", shape.xcross, location.belowbar, color.new(color.red, 30),   size = size.tiny)
plotshape(showMarks and crossUp,     "EMA x> VWAP",  shape.circle, location.bottom, color.new(color.green, 40), size = size.tiny)
plotshape(showMarks and crossDown,   "EMA x< VWAP",  shape.circle, location.top,    color.new(color.red, 40),   size = size.tiny)

// ─── Timeframe warning ──────────────────────────────────────────────────────
var bool everZero = false
if sizeZero
    everZero := true

var table tfWarn = table.new(position.bottom_right, 1, 2)
if barstate.islast
    table.clear(tfWarn, 0, 0, 0, 1)
    if timeframe.period != intendedTF
        table.cell(tfWarn, 0, 0, "Chart TF " + timeframe.period + " vs intended " + intendedTF,
             text_color = color.white, bgcolor = color.new(color.red, 20), text_size = size.small)
    if everZero
        table.cell(tfWarn, 0, 1, "Size = 0 contracts: set Order Size Mode to Fixed Quantity",
             text_color = color.white, bgcolor = color.new(color.orange, 10), text_size = size.small)
